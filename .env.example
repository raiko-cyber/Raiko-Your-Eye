# Скопируйте этот файл под именем .env и впишите свой ключ.
# Файл .env никому не отправляйте и не выкладывайте в интернет.

# Ключ Gemini API. Его создают бесплатно в Google AI Studio (раздел API keys).
GEMINI_API_KEY=

# Модель. Если строку не трогать, используется gemini-3.5-flash-lite (быстрая).
# MODEL=gemini-3.5-flash-lite

# Запасные модели через запятую. Если основная перегружена или молчит дольше
# AI_TIMEOUT_SEC секунд, сервер сам пробует следующую.
# FALLBACK_MODELS=gemini-3.5-flash,gemini-3.8-flash
# AI_TIMEOUT_SEC=15

# Сколько запросов в минуту разрешено на всех пользователей вместе.
# GLOBAL_LIMIT_PER_MIN=60

# Порт, на котором запускается приложение на компьютере.
PORT=3000

# Сколько запросов в минуту разрешено с одного телефона.
RATE_LIMIT_PER_MIN=20

# Необязательно: вместо Gemini можно использовать Claude (платно).
# Тогда уберите ключ Gemini и впишите ключ Anthropic:
# ANTHROPIC_API_KEY=
